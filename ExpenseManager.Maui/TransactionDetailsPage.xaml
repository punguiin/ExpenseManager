<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpenseManager.Maui.TransactionDetailsPage"
             Title="Деталі транзакції"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <StackLayout Spacing="0">
            <!-- Amount header -->
            <Frame x:Name="HeaderFrame"
                   CornerRadius="0"
                   Padding="24,32"
                   HasShadow="True"
                   BorderColor="Transparent">
                <StackLayout Spacing="4" HorizontalOptions="Center">
                    <Label x:Name="TypeLabel"
                           FontSize="14"
                           HorizontalOptions="Center" />
                    <Label x:Name="AmountLabel"
                           FontSize="38"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Frame>

            <!-- Details card -->
            <Frame BackgroundColor="White"
                   CornerRadius="16"
                   Padding="20"
                   Margin="16,20,16,16"
                   HasShadow="True"
                   BorderColor="Transparent">
                <StackLayout Spacing="0">
                    <!-- Category -->
                    <Label Text="Категорія"
                           FontSize="12"
                           TextColor="{StaticResource Gray400}" />
                    <Label x:Name="CategoryLabel"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}"
                           Margin="0,2,0,16" />

                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                    <!-- Description -->
                    <Label Text="Опис"
                           FontSize="12"
                           TextColor="{StaticResource Gray400}"
                           Margin="0,16,0,0" />
                    <Label x:Name="DescriptionLabel"
                           FontSize="17"
                           TextColor="{StaticResource Gray900}"
                           Margin="0,2,0,16" />

                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                    <!-- Date -->
                    <Label Text="Дата"
                           FontSize="12"
                           TextColor="{StaticResource Gray400}"
                           Margin="0,16,0,0" />
                    <Label x:Name="DateLabel"
                           FontSize="17"
                           TextColor="{StaticResource Gray900}"
                           Margin="0,2,0,0" />
                </StackLayout>
            </Frame>
        </StackLayout>
    </ScrollView>

</ContentPage>
