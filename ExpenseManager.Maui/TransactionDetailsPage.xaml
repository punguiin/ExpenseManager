<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseManager.Maui.ViewModels"
             x:Class="ExpenseManager.Maui.TransactionDetailsPage"
             x:DataType="vm:TransactionDetailsViewModel"
             Title="Деталі транзакції"
             BackgroundColor="{StaticResource Gray100}">

    <Grid>
        <ScrollView IsEnabled="{Binding IsNotBusy}">
            <StackLayout Spacing="0">

                <Border BackgroundColor="{Binding HeaderColor}"
                        StrokeShape="RoundRectangle 0"
                        Padding="16,24"
                        Stroke="Transparent">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Border Grid.Column="0"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 24"
                                WidthRequest="48"
                                HeightRequest="48"
                                Padding="0"
                                Stroke="Transparent"
                                VerticalOptions="Start">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding BackCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="←"
                                   FontSize="28"
                                   FontAttributes="Bold"
                                   TextColor="{Binding HeaderColor}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                        <StackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                            <Label Text="{Binding TypeText}"
                                   TextColor="{Binding TypeLabelColor}"
                                   FontSize="14"
                                   HorizontalOptions="Center" />
                            <Label Text="{Binding AmountText}"
                                   FontSize="38"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   HorizontalOptions="Center" />
                        </StackLayout>
                    </Grid>
                </Border>

                <Grid Padding="16,12,16,0"
                      ColumnDefinitions="*,*"
                      ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="Редагувати"
                            Command="{Binding EditCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8" />
                    <Button Grid.Column="1"
                            Text="Видалити"
                            Command="{Binding DeleteCommand}"
                            BackgroundColor="#E53935"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8" />
                </Grid>

                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 16"
                        Padding="20"
                        Margin="16,16,16,16"
                        Stroke="Transparent">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                    </Border.Shadow>
                    <StackLayout Spacing="0">
                        <Label Text="Категорія"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}" />
                        <Label Text="{Binding CategoryText}"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}"
                               Margin="0,2,0,16" />

                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                        <Label Text="Опис"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}"
                               Margin="0,16,0,0" />
                        <Label Text="{Binding DescriptionText}"
                               FontSize="17"
                               TextColor="{StaticResource Gray900}"
                               Margin="0,2,0,16" />

                        <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                        <Label Text="Дата"
                               FontSize="12"
                               TextColor="{StaticResource Gray400}"
                               Margin="0,16,0,0" />
                        <Label Text="{Binding DateText}"
                               FontSize="17"
                               TextColor="{StaticResource Gray900}"
                               Margin="0,2,0,0" />
                    </StackLayout>
                </Border>
            </StackLayout>
        </ScrollView>

        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#80000000">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               Color="White"
                               WidthRequest="50"
                               HeightRequest="50"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
