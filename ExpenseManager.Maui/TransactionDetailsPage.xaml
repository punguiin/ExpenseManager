<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpenseManager.Maui.TransactionDetailsPage"
             Title="Деталі транзакції"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <StackLayout Spacing="0">
            <!-- Amount header -->
            <Border BackgroundColor="{Binding HeaderColor}"
                    StrokeShape="RoundRectangle 0"
                    Padding="24,32"
                    Stroke="Transparent">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                </Border.Shadow>
                <StackLayout Spacing="4" HorizontalOptions="Center">
                    <Label Text="{Binding TypeText}"
                           TextColor="{Binding TypeLabelColor}"
                           FontSize="14"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding AmountText}"
                           FontSize="38"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                </StackLayout>
            </Border>

            <!-- Details card -->
            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 16"
                    Padding="20"
                    Margin="16,20,16,16"
                    Stroke="Transparent">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                </Border.Shadow>
                <StackLayout Spacing="0">
                    <!-- Category -->
                    <Label Text="Категорія"
                           FontSize="12"
                           TextColor="{StaticResource Gray400}" />
                    <Label Text="{Binding CategoryText}"
                           FontSize="17"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}"
                           Margin="0,2,0,16" />

                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                    <!-- Description -->
                    <Label Text="Опис"
                           FontSize="12"
                           TextColor="{StaticResource Gray400}"
                           Margin="0,16,0,0" />
                    <Label Text="{Binding DescriptionText}"
                           FontSize="17"
                           TextColor="{StaticResource Gray900}"
                           Margin="0,2,0,16" />

                    <BoxView HeightRequest="1" Color="{StaticResource Gray100}" />

                    <!-- Date -->
                    <Label Text="Дата"
                           FontSize="12"
                           TextColor="{StaticResource Gray400}"
                           Margin="0,16,0,0" />
                    <Label Text="{Binding DateText}"
                           FontSize="17"
                           TextColor="{StaticResource Gray900}"
                           Margin="0,2,0,0" />
                </StackLayout>
            </Border>
        </StackLayout>
    </ScrollView>

</ContentPage>
