               x:Class="ExpenseManager.Maui.TransactionDetailsPage"
               Title="Деталі транзакції">

    <StackLayout Padding="15" Spacing="10">
        <Label x:Name="AmountLabel" FontSize="24" FontAttributes="Bold" />
