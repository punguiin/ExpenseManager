<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpenseManager.Maui.WalletDetailsPage"
             Title="Деталі гаманця"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <StackLayout Spacing="0">
            <!-- Wallet info card -->
            <Border BackgroundColor="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 0"
                    Padding="24,28"
                    Stroke="Transparent">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                </Border.Shadow>
                <StackLayout Spacing="6">
                    <Label Text="{Binding Name}"
                           FontSize="26"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="{Binding CurrencyText}"
                           FontSize="15"
                           TextColor="{StaticResource Secondary}" />
                    <BoxView HeightRequest="1"
                             Color="{StaticResource PrimaryDark}"
                             Opacity="0.3"
                             Margin="0,8" />
                    <Label Text="Баланс"
                           FontSize="13"
                           TextColor="{StaticResource Secondary}" />
                    <Label Text="{Binding BalanceText}"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="White" />
                </StackLayout>
            </Border>

            <!-- Transactions header -->
            <Label Text="Транзакції"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource Gray900}"
                   Margin="16,20,16,8" />

            <!-- Transactions list -->
            <CollectionView ItemsSource="{Binding Transactions}"
                            SelectedItem="{Binding SelectedTransaction}"
                            SelectionMode="Single"
                            Margin="12,0">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="White"
                                StrokeShape="RoundRectangle 10"
                                Padding="14"
                                Margin="4,5"
                                Stroke="Transparent">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                <!-- Category badge -->
                                <Border Grid.RowSpan="2"
                                        BackgroundColor="{StaticResource Secondary}"
                                        StrokeShape="RoundRectangle 20"
                                        WidthRequest="40"
                                        HeightRequest="40"
                                        Padding="0"
                                        Stroke="Transparent"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Category}"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Tertiary}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                </Border>

                                <!-- Description -->
                                <Label Grid.Column="1"
                                       Text="{Binding Description}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource Gray900}"
                                       Margin="10,0,0,0"
                                       VerticalOptions="End"
                                       LineBreakMode="TailTruncation" />

                                <!-- Date -->
                                <Label Grid.Column="1"
                                       Grid.Row="1"
                                       Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}"
                                       FontSize="12"
                                       TextColor="{StaticResource Gray400}"
                                       Margin="10,2,0,0"
                                       VerticalOptions="Start" />

                                <!-- Amount -->
                                <Label Grid.Column="2"
                                       Grid.RowSpan="2"
                                       Text="{Binding Amount, StringFormat='{0:+#.00;-#.00;0.00}'}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       HorizontalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="40">
                        <Label Text="Немає транзакцій"
                               FontSize="18"
                               TextColor="{StaticResource Gray400}"
                               HorizontalOptions="Center" />
                    </StackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </StackLayout>
    </ScrollView>

</ContentPage>
