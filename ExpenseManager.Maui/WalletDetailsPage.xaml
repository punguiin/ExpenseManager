<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               x:Class="ExpenseManager.Maui.WalletDetailsPage"
               Title="Деталі гаманця">

    <StackLayout Padding="15" Spacing="10">
        <Label x:Name="NameLabel" FontSize="24" FontAttributes="Bold" />
        <Label x:Name="CurrencyLabel" FontSize="16" />
        <Label x:Name="BalanceLabel" FontSize="16" />

        <Label Text="Транзакції:" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />

        <ListView x:Name="TransactionsListView"
                    ItemSelected="OnTransactionSelected">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding Description}"
                                Detail="{Binding Amount, StringFormat='{0:+#;-#;0}'}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>

</ContentPage>