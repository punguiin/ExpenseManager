<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpenseManager.Maui.WalletsPage"
             Title="Гаманці"
             BackgroundColor="{StaticResource Gray100}">

    <CollectionView x:Name="WalletsCollectionView"
                    SelectionMode="Single"
                    SelectionChanged="OnWalletSelected"
                    Margin="12,8">
        <CollectionView.Header>
            <StackLayout Padding="4,12,4,4">
                <Label Text="Ваші гаманці"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}" />
                <Label x:Name="WalletCountLabel"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       Margin="0,2,0,8" />
            </StackLayout>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame BackgroundColor="White"
                       CornerRadius="12"
                       Padding="16"
                       Margin="4,6"
                       HasShadow="True"
                       BorderColor="Transparent">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <!-- Currency icon -->
                        <Frame Grid.RowSpan="2"
                               BackgroundColor="{StaticResource Secondary}"
                               CornerRadius="24"
                               WidthRequest="48"
                               HeightRequest="48"
                               Padding="0"
                               HasShadow="False"
                               VerticalOptions="Center">
                            <Label Text="{Binding Currency}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Tertiary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Frame>

                        <!-- Name -->
                        <Label Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}"
                               Margin="12,0,0,0"
                               VerticalOptions="End" />

                        <!-- Transaction count -->
                        <Label Grid.Column="1"
                               Grid.Row="1"
                               Text="{Binding Transactions.Count, StringFormat='{0} транзакцій'}"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}"
                               Margin="12,2,0,0"
                               VerticalOptions="Start" />

                        <!-- Balance -->
                        <Label Grid.Column="2"
                               Grid.RowSpan="2"
                               Text="{Binding TotalBalance, StringFormat='{0:N2}'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"
                               HorizontalOptions="End" />
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="40">
                <Label Text="Немає гаманців"
                       FontSize="20"
                       TextColor="{StaticResource Gray400}"
                       HorizontalOptions="Center" />
            </StackLayout>
        </CollectionView.EmptyView>
    </CollectionView>

</ContentPage>
