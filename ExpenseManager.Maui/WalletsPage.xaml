<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ExpenseManager.Maui.WalletsPage"
             Title="Гаманці"
             BackgroundColor="{StaticResource Gray100}">

    <CollectionView ItemsSource="{Binding Wallets}"
                    SelectedItem="{Binding SelectedWallet}"
                    SelectionMode="Single"
                    Margin="12,8">
        <CollectionView.Header>
            <StackLayout Padding="4,12,4,4">
                <Label Text="Ваші гаманці"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Gray900}" />
                <Label Text="{Binding WalletCountText}"
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       Margin="0,2,0,8" />
            </StackLayout>
        </CollectionView.Header>
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 12"
                        Padding="16"
                        Margin="4,6"
                        Stroke="Transparent">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.15" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                        <!-- Currency icon -->
                        <Border Grid.RowSpan="2"
                                BackgroundColor="{StaticResource Secondary}"
                                StrokeShape="RoundRectangle 24"
                                WidthRequest="48"
                                HeightRequest="48"
                                Padding="0"
                                Stroke="Transparent"
                                VerticalOptions="Center">
                            <Label Text="{Binding Currency}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Tertiary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- Name -->
                        <Label Grid.Column="1"
                               Text="{Binding Name}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Gray900}"
                               Margin="12,0,0,0"
                               VerticalOptions="End" />

                        <!-- Transaction count -->
                        <Label Grid.Column="1"
                               Grid.Row="1"
                               Text="{Binding TransactionCount, StringFormat='{0} транзакцій'}"
                               FontSize="13"
                               TextColor="{StaticResource Gray400}"
                               Margin="12,2,0,0"
                               VerticalOptions="Start" />

                        <!-- Balance -->
                        <Label Grid.Column="2"
                               Grid.RowSpan="2"
                               Text="{Binding TotalBalance, StringFormat='{0:N2}'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}"
                               VerticalOptions="Center"
                               HorizontalOptions="End" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
        <CollectionView.EmptyView>
            <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="40">
                <Label Text="Немає гаманців"
                       FontSize="20"
                       TextColor="{StaticResource Gray400}"
                       HorizontalOptions="Center" />
            </StackLayout>
        </CollectionView.EmptyView>
    </CollectionView>

</ContentPage>
